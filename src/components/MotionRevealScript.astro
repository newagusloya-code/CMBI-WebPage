<script>
  const root = document.documentElement;
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  root.dataset.js = "true";
  if (prefersReducedMotion.matches) {
    root.dataset.motion = "reduced";
  }

  const getHeaderOffset = () => {
    const utilityBar = document.querySelector(".utility-bar");
    const siteHeader = document.querySelector(".site-header");
    return (utilityBar?.offsetHeight ?? 0) + (siteHeader?.offsetHeight ?? 0) + 16;
  };

  const scrollToHashTarget = (hash, force = false) => {
    if (!hash) return;

    const id = decodeURIComponent(hash.slice(1));
    if (!id) return;

    const target = document.getElementById(id);
    if (!target) return;

    const reduceMotion = root.dataset.motion === "reduced" || prefersReducedMotion.matches;
    const top = Math.max(0, window.scrollY + target.getBoundingClientRect().top - getHeaderOffset());
    const difference = Math.abs(window.scrollY - top);

    if (!force && difference < 4) return;

    window.scrollTo({
      top,
      behavior: reduceMotion ? "auto" : "smooth",
    });
  };

  const syncHashScroll = (force = false) => {
    if (!window.location.hash) return;
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        scrollToHashTarget(window.location.hash, force);
      });
    });
  };

  window.addEventListener("load", () => syncHashScroll(true), { once: true });
  window.addEventListener("hashchange", () => syncHashScroll(true));

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.setAttribute("data-visible", "true");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.16 }
  );

  document.querySelectorAll(".reveal").forEach((element) => observer.observe(element));
</script>
