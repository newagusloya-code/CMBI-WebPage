---
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../data/site";
---

<Layout title={`Cookies | ${siteConfig.name}`} description="Preferencias de cookies de CMBI Centro Médico de Bienestar Integral.">
  <main class="section">
    <div class="container section-heading">
      <p class="eyebrow">Cookies</p>
      <h1>Preferencias de cookies</h1>
      <p>
        Este sitio usa almacenamiento local para recordar tu preferencia sobre este aviso.
      </p>
      <p>
        Puedes aceptar el aviso o conservar únicamente las preferencias necesarias.
      </p>
      <a class="button button-secondary" href="/">Volver al inicio</a>
    </div>
  </main>
</Layout>
