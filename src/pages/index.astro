---
import Layout from "../layouts/Layout.astro"
import MotionRevealScript from "../components/MotionRevealScript.astro"
import SiteFooter from "../components/SiteFooter.astro"
import SiteHeader from "../components/SiteHeader.astro"
import {
  benefitCards,
  galleryItems,
  serviceCards,
  servicePages,
  settings,
  siteConfig,
} from "../data/site"

const structuredData = {
  "@context": "https://schema.org",
  "@type": "HealthAndBeautyBusiness",
  name: siteConfig.fullName,
  alternateName: siteConfig.name,
  description: siteConfig.description,
  image: settings.images.hero,
  areaServed: "Ensenada, Baja California, México",
  address: {
    "@type": "PostalAddress",
      streetAddress: "De Las Redes 96",
      postalCode: "22880",
      addressLocality: "Ensenada",
      addressRegion: "Baja California",
      addressCountry: "MX",
  },
  sameAs: [settings.socialLinks.instagram, settings.socialLinks.facebook],
}
---

<Layout title={siteConfig.title} description={siteConfig.description}>
  <main class="site-shell" id="contenido">
    <SiteHeader />

    <section class="hero" id="inicio">
      <div class="hero-surface">
        <img
          class="hero-image"
          src={settings.images.hero}
          alt="Recepción luminosa de CMBI con área de espera, consultorio y alberca al fondo."
          fetchpriority="high"
        />
        <div class="hero-gradient"></div>
      </div>

      <div class="container hero-grid">
        <div class="hero-copy reveal">
          <p class="eyebrow">Bienestar integral para todas las edades</p>
          <h1>Salud, movimiento y cuidado personal en un solo lugar.</h1>
          <p class="hero-lead">
            CMBI reúne nutrición, terapias regenerativas, agua, movimiento y cuidado
            personal para que cada persona encuentre rápido el servicio que necesita.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href={siteConfig.reserveHref} target="_blank" rel="noreferrer">Agendar por WhatsApp</a>
            <a class="button button-secondary" href={siteConfig.consultHref}>Ver servicios</a>
            <a class="button button-ghost" href={siteConfig.experienceHref}>Ver instalaciones</a>
          </div>
          <div class="badge-row" aria-label="Áreas principales de CMBI">
            {siteConfig.heroBadges.map((badge) => <span>{badge}</span>)}
          </div>
        </div>

        <aside class="hero-panel reveal" aria-label="Resumen de atención CMBI">
          <div class="panel-card">
            <p class="panel-eyebrow">Atención por intención</p>
            <ul>
              <li>Primero entendemos tu objetivo y la etapa de vida de la persona.</li>
              <li>Organizamos los servicios por salud, movimiento, agua y cuidado personal.</li>
              <li>Te ayudamos a dar el siguiente paso sin saturarte de información.</li>
            </ul>
          </div>

          <div class="panel-stats">
            {siteConfig.heroStats.map((stat) => (
              <article>
                <strong>{stat.value}</strong>
                <span>{stat.label}</span>
              </article>
            ))}
          </div>
        </aside>
      </div>
    </section>

    <section class="section analysis-section" id="analisis">
      <div class="container split-grid">
        <div class="section-heading reveal">
          <p class="eyebrow">Ruta de atención</p>
          <h2>Una ruta clara para elegir el servicio adecuado.</h2>
          <p>
            CMBI organiza sus áreas para que puedas elegir con calma: salud y
            recuperación, movimiento y acondicionamiento, agua y clases, o relajación
            y cuidado personal. La experiencia prioriza claridad y orientación humana.
          </p>
        </div>
        <div class="quote-panel reveal">
          <blockquote>
            Un espacio donde la atención profesional, el descanso y el cuidado personal
            se encuentran sin ruido ni prisa.
          </blockquote>
        </div>
      </div>
    </section>

    <section class="section" id="servicios">
      <div class="container">
        <div class="section-heading reveal">
          <p class="eyebrow">Áreas integrales de bienestar</p>
          <h2>Servicios agrupados por lo que necesitas hoy.</h2>
          <p>
            Agrupamos las áreas para que encuentres rápido la opción que mejor encaja
            con tu objetivo: salud, movimiento, agua, relajación o cuidado personal.
          </p>
        </div>

        <div class="services-carousel reveal" data-services-carousel>
          <div class="carousel-actions" aria-label="Controles de servicios">
            <button type="button" data-carousel-prev aria-label="Ver servicios anteriores" aria-controls="services-track">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5 8 12l7 7" /></svg>
            </button>
            <button type="button" data-carousel-next aria-label="Ver más servicios" aria-controls="services-track">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
            </button>
          </div>

          <div id="services-track" class="program-grid" data-carousel-track tabindex="0" aria-label="Servicios CMBI">
            {serviceCards.map((card) => (
              <article class="program-card" id={card.id}>
                <div class="card-media">
                  <img src={card.image} alt={card.alt} loading="lazy" draggable="false" />
                </div>
                <div class="card-copy">
                  <p class="card-eyebrow">{card.eyebrow}</p>
                  <h3>{card.title}</h3>
                  <p>{card.copy}</p>
                  <a class="card-link" href={card.href} aria-label={`Ver página de ${card.eyebrow}`}>
                    {card.cta}
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section benefits-section" id="beneficios">
      <div class="container">
        <div class="section-heading reveal">
          <p class="eyebrow">Beneficios del enfoque integral</p>
          <h2>Te acompañamos con orientación profesional y una experiencia fácil de entender.</h2>
        </div>
        <div class="benefit-grid">
          {benefitCards.map((item) => (
            <article class="mini-card reveal">
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section destination-section" id="instalaciones">
      <div class="container">
        <div class="section-heading reveal">
          <p class="eyebrow">Instalaciones</p>
          <h2>Conoce nuestras áreas y elige el espacio para tu objetivo.</h2>
        </div>

        <div class="gallery-grid">
          {galleryItems.map((item) => (
            <a class="gallery-card reveal" href={item.href} aria-label={`Ver ${item.caption}`}>
              <img src={item.image} alt={item.alt} loading="lazy" />
              <span class="gallery-caption">{item.caption}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section about-section" id="ubicacion">
      <div class="container split-grid">
        <div class="split-copy reveal">
          <p class="eyebrow">Sobre CMBI + ubicación</p>
          <h2>Un centro integral ubicado en la zona costera de Ensenada.</h2>
          <p>
            CMBI comunica una promesa sencilla: acompañar a las personas desde una
            mirada integral, con espacios cuidados, servicios complementarios y una
            agenda fácil de iniciar por conversación.
          </p>
          <p>
            Consulta la ubicación exacta y el horario general antes de tu visita.
          </p>
          <div class="check-grid">
            <span>Playa Ensenada</span>
            <span>Agenda por WhatsApp</span>
            <span>Horario general: {siteConfig.hours}</span>
            <a href={siteConfig.locationHref} target="_blank" rel="noreferrer">Abrir ubicación</a>
          </div>
        </div>
        <a class="map-link reveal" href={siteConfig.locationHref} target="_blank" rel="noreferrer" aria-label="Abrir ubicación de CMBI en Google Maps">
          <img class="map-image" src={settings.images.map} alt="Referencia visual de la ubicación de CMBI en Playa Ensenada." loading="lazy" />
        </a>
      </div>
    </section>

    <section class="section contact-section" id="contacto">
      <div class="container contact-grid">
        <div class="section-heading reveal">
          <p class="eyebrow">Agenda por WhatsApp</p>
          <h2>Empieza por una conversación breve y bien dirigida.</h2>
          <p>{siteConfig.contactBlock.copy}</p>
        </div>

        <div class="contact-panel reveal">
          <p class="card-eyebrow">{siteConfig.contactBlock.heading}</p>
          <p>{siteConfig.contactBlock.note}</p>
          <div class="contact-actions">
            <a class="button button-primary" href={siteConfig.reserveHref} target="_blank" rel="noreferrer">Agendar cita</a>
            {servicePages.map((service) => (
              <a class="button button-secondary" href={`/servicios/${service.slug}`}>{service.shortTitle}</a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <SiteFooter />

    <div class="cookie-banner" data-cookie-banner role="region" aria-label="Preferencias de cookies">
      <div class="cookie-copy">
        <p class="card-eyebrow">Cookies</p>
        <h3>{siteConfig.cookie.title}</h3>
        <p>{siteConfig.cookie.body}</p>
      </div>

      <div class="cookie-actions">
        <button class="button button-primary" type="button" data-cookie-accept>{siteConfig.cookie.primary}</button>
        <button class="button button-secondary" type="button" data-cookie-minimal>{siteConfig.cookie.secondary}</button>
      </div>
    </div>

    <button class="cookie-toggle" type="button" data-cookie-toggle hidden>Cookies</button>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
  <script>
    const storageKey = "cmbi-cookie-consent";
    const banner = document.querySelector("[data-cookie-banner]");
    const toggle = document.querySelector("[data-cookie-toggle]");
    const accept = document.querySelector("[data-cookie-accept]");
    const minimal = document.querySelector("[data-cookie-minimal]");

    const setConsent = (value) => {
      try {
        window.localStorage.setItem(storageKey, value);
      } catch {}
      if (banner) {
        banner.setAttribute("data-state", value);
        banner.hidden = true;
      }
      if (toggle) toggle.hidden = false;
    };

    const savedConsent = (() => {
      try {
        return window.localStorage.getItem(storageKey);
      } catch {
        return null;
      }
    })();

    if (savedConsent) {
      banner?.setAttribute("data-state", savedConsent);
      if (banner) banner.hidden = true;
      if (toggle) toggle.hidden = false;
    } else {
      banner?.setAttribute("data-state", "open");
      if (toggle) toggle.hidden = true;
    }

    accept?.addEventListener("click", () => setConsent("accepted"));
    minimal?.addEventListener("click", () => setConsent("necessary"));
    toggle?.addEventListener("click", () => {
      if (!banner) return;
      banner.hidden = false;
      banner.setAttribute("data-state", "open");
      toggle.hidden = true;
    });

  </script>
  <MotionRevealScript />
  <script>
    const carousel = document.querySelector("[data-services-carousel]");
    const track = carousel?.querySelector("[data-carousel-track]");
    const previous = carousel?.querySelector("[data-carousel-prev]");
    const next = carousel?.querySelector("[data-carousel-next]");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    if (carousel && track instanceof HTMLElement) {
      const cardStep = () => {
        const card = track.querySelector(".program-card");
        if (!(card instanceof HTMLElement)) return track.clientWidth * 0.82;
        const gap = Number.parseFloat(window.getComputedStyle(track).columnGap) || 0;
        return card.offsetWidth + gap;
      };

      const moveByCard = (direction) => {
        track.scrollBy({
          left: cardStep() * direction,
          behavior: reducedMotion.matches ? "auto" : "smooth",
        });
      };

      previous?.addEventListener("click", () => moveByCard(-1));
      next?.addEventListener("click", () => moveByCard(1));
      track.addEventListener("keydown", (event) => {
        if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
          event.preventDefault();
          moveByCard(event.key === "ArrowLeft" ? -1 : 1);
        }
      });

      let edgeSpeed = 0;
      let animationFrame = 0;
      let dragging = false;
      let dragged = false;
      let dragStartX = 0;
      let dragStartScroll = 0;

      const animateEdgeScroll = () => {
        if (edgeSpeed !== 0 && !dragging && !reducedMotion.matches) {
          track.scrollLeft += edgeSpeed;
          animationFrame = requestAnimationFrame(animateEdgeScroll);
        } else {
          animationFrame = 0;
        }
      };

      const setEdgeSpeed = (event) => {
        if (dragging || reducedMotion.matches || event.pointerType === "touch") return;
        const bounds = track.getBoundingClientRect();
        const position = (event.clientX - bounds.left) / bounds.width;
        const edgeZone = 0.22;

        if (position < edgeZone) {
          edgeSpeed = -Math.max(2, ((edgeZone - position) / edgeZone) * 12);
        } else if (position > 1 - edgeZone) {
          edgeSpeed = Math.max(2, ((position - (1 - edgeZone)) / edgeZone) * 12);
        } else {
          edgeSpeed = 0;
        }

        if (edgeSpeed !== 0 && animationFrame === 0) {
          animationFrame = requestAnimationFrame(animateEdgeScroll);
        }
      };

      track.addEventListener("pointermove", (event) => {
        if (dragging) {
          if (Math.abs(event.clientX - dragStartX) > 6) dragged = true;
          track.scrollLeft = dragStartScroll - (event.clientX - dragStartX);
          return;
        }
        setEdgeSpeed(event);
      });

      track.addEventListener("mousemove", (event) => {
        if (!dragging) setEdgeSpeed(event);
      });

      track.addEventListener("pointerleave", () => {
        edgeSpeed = 0;
        dragging = false;
        track.removeAttribute("data-dragging");
      });

      track.addEventListener("pointerdown", (event) => {
        if (event.pointerType === "touch" || event.button !== 0) return;
        dragging = true;
        dragged = false;
        edgeSpeed = 0;
        dragStartX = event.clientX;
        dragStartScroll = track.scrollLeft;
        track.setAttribute("data-dragging", "true");
        track.setPointerCapture(event.pointerId);
      });

      track.addEventListener("pointerup", (event) => {
        if (!dragging) return;
        dragging = false;
        track.removeAttribute("data-dragging");
        track.releasePointerCapture(event.pointerId);
      });

      track.addEventListener("pointercancel", () => {
        dragging = false;
        track.removeAttribute("data-dragging");
      });

      track.addEventListener("click", (event) => {
        if (!dragged) return;
        event.preventDefault();
        dragged = false;
      }, { capture: true });

      track.addEventListener("wheel", (event) => {
        if (Math.abs(event.deltaY) <= Math.abs(event.deltaX)) return;
        event.preventDefault();
        track.scrollLeft += event.deltaY;
      }, { passive: false });
    }
  </script>
</Layout>
